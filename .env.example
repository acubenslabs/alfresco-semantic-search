# --- Alfresco -----------------------------------------------------------
ALFRESCO_URL=http://localhost:8080
# Service account used for indexing (reads content and metadata).
ALFRESCO_USER=admin
ALFRESCO_PASSWORD=admin

# --- Transform service (text extraction) --------------------------------
TRANSFORM_URL=http://localhost:8090

# --- ActiveMQ / Event2 --------------------------------------------------
# STOMP must be enabled on the broker first: scripts/enable-stomp.sh
STOMP_HOST=localhost
STOMP_PORT=61613
STOMP_USER=admin
STOMP_PASSWORD=admin

# --- pgvector -----------------------------------------------------------
PGVECTOR_DSN=postgresql://rag:rag@localhost:5433/rag

# --- Embeddings ---------------------------------------------------------
# text-embedding-3-small = 1536 dims, -3-large = 3072.
# Leave OPENAI_API_KEY empty to use the deterministic FakeEmbedder (demo only).
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
